# StockRescue Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.

# FastAPI backend base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# Supabase project URL (public, safe to expose)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/publishable key (public, safe to expose)
# DO NOT use the service-role key here — it must never reach the browser
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Warehouse twin start mode: "simulation" (default, scenario data labelled SIMULATED)
# or "live" (reads /api/warehouse/*, /api/inventory, ... and /ws/events from the backend)
VITE_TWIN_MODE=simulation

# Optional override for the twin event stream; defaults to ws(s)://<VITE_API_BASE_URL host>/ws/events
# VITE_TWIN_WS_URL=ws://localhost:8000/ws/events

# Age in ms after which LIVE twin data is flagged STALE and the 3D scene desaturates
# VITE_TWIN_STALE_MS=60000
